[sub_resource type="GDScript" id="GDScript_37kl0"]
script/source = "extends StaticBody2D


func _draw() -> void:
	for child: Node2D in get_children():
		if child is CollisionPolygon2D:
			var new_poly: PackedVector2Array = (child as CollisionPolygon2D).polygon
			for index in range(new_poly.size()):
				new_poly[index] += child.global_position
			draw_polygon(new_poly, [Color.WHITE])
		else:
			var segment: SegmentShape2D = (child as CollisionShape2D).shape
			var a: Vector2 = child.transform * segment.a
			var b: Vector2 = child.transform * segment.b
			draw_line(a, b, Color.WHITE)
"

